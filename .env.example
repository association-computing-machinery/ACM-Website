# ACM ITU website — environment template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored on
# purpose: it holds a database URL, an ImageKit private key and SMTP
# credentials. Never commit it, and never paste real keys into this template.
#
#   cp .env.example .env
#
# Generate a strong rate-limit / code-signing secret with either:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32

# ── Database ────────────────────────────────────────────────────────────────
# Either DATABASE_URL or the MYSQL_* block below. DATABASE_URL wins if both are
# set. TLS is enforced unless MYSQL_SSL=disable, which is only allowed for a
# local database outside production.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/acm_itu_db

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=acm_itu_db
# disable | verify-full (default)
MYSQL_SSL=disable

# ── API ─────────────────────────────────────────────────────────────────────
PORT=3001

# Interface to listen on. 127.0.0.1 (default) is this machine only; use
# 0.0.0.0 when a container, VM or reverse proxy has to reach the API.
HOST=127.0.0.1

# How long a SIGINT/SIGTERM shutdown may take before the process is forced to
# exit (milliseconds). Guards against a stuck request blocking a restart.
SHUTDOWN_GRACE_MS=10000

# Serve the built frontend (frontend/dist) from this same process, so one host
# can run the whole app. Defaults to on when a build is present.
SERVE_FRONTEND=true

# The exact origin the browser app is served from. POST/PUT/PATCH requests from
# any other origin are rejected.
APP_ORIGIN=http://127.0.0.1:5173

# Required (32+ characters). Signs password-reset code hashes and rate-limit
# keys. The service returns 503 for those routes if it is missing or too short.
RATE_LIMIT_SECRET=

# ── ImageKit (client-side uploads) ──────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# ── Email / OTP ─────────────────────────────────────────────────────────────
# Port 465 uses implicit TLS; 587 upgrades with STARTTLS.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
# For Gmail, use an App Password — never the account password.
EMAIL_PASS=
EMAIL_FROM=ACM ITU <you@example.com>

# Most verification emails this install will send per day, across all
# recipients. A backstop against one attacker spraying many addresses (which is
# how a sending domain gets blacklisted); the per-address and per-IP limits on
# the auth routes still apply.
EMAIL_DAILY_LIMIT=200
