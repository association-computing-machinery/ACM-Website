{
  "name": "acm-itu-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "concurrently -n \"api,app\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev\"",
    "dev": "npm --prefix frontend run dev",
    "dev:api": "node --env-file-if-exists=.env --watch backend/src/server.js",
    "start:api": "node --env-file-if-exists=.env backend/src/server.js",
    "build": "npm --prefix frontend run build",
    "lint": "eslint .",
    "test": "node --test backend/test/",
    "test:in-process": "node --test --test-isolation=none \"backend/test/*.test.js\"",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.5",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "mysql2": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
